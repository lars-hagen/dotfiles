# Config syntax crash course
# ==========================
# # The config file consists of simple key-value pairs,
# # separated by equals signs.
# font-family = Iosevka
# window-padding-x = 2
#
# # Spacing around the equals sign does not matter.
# # All of these are identical:
# key=value
# key= value
# key =value
# key = value
#
# # Any line beginning with a # is a comment. It's not possible to put
# # a comment after a config option, since it would be interpreted as a
# # part of the value. For example, this will have a value of "#123abc":
# background = #123abc
#
# # Empty values are used to reset config keys to default.
# key =
#
# # Some config options have unique syntaxes for their value,
# # which is explained in the docs for that config option.
# # Just for example:
# resize-overlay-duration = 4s 200ms

# Terminal Configuration
# ======================
term = xterm-256color

# Dropdown Terminal Configuration
# ================================

# Toggle visibility with Ctrl+Shift+Space
# Use Raycast to position and size the window
# keybind = global:control+shift+space=toggle_visibility

# Remember window size/position between sessions
window-save-state = always

# Quit Ghostty when last window closes (so it restores saved state on relaunch)
# quit-after-last-window-closed = true

# Set default window size (in terminal grid cells)
# Adjust these values to match your preferred size
# window-width = 120
# window-height = 40

# Font Configuration
# ==================

# Let Ghostty handle font weight variations automatically
# (Using explicit bold/italic variants causes bold text not to render)
font-family = FiraCode Nerd Font

alpha-blending = linear
adjust-underline-position = 15%
font-feature = -calt

# Font size
font-size = 14

adjust-cell-width = -7%

# Color Configuration
# ===================
# Using Tabby's exact Argonaut color values

background = #0e1019
foreground = #ffffff
cursor-color = #ffffff
cursor-style = block
cursor-style-blink = true

# Disable shell integration cursor override (it forces bar cursor at prompt)
shell-integration-features = no-cursor

# ANSI Colors (0-15) - Copied from Tabby
palette = 0=#232323
palette = 1=#ff000f
palette = 2=#8ce10b
